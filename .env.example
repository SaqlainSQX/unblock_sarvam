# Copy privately to .env.local during implementation. Never commit real values.
SARVAM_API_KEY=
MENTOR_PASSCODE=
ALLOW_LIVE_API=false
LIVE_MAX_DISPATCHES=6
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_ASR_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
# Blank selects the documented model default; do not reuse v3 short speaker IDs.
SARVAM_TTS_SPEAKER=
DATA_DIR=.data/app
# Keep these outside DATA_DIR so clearing synthetic app records cannot reset spend.
DISPATCH_LEDGER_PATH=.data/dispatch-ledger.json
PROVIDER_CACHE_DIR=.data/provider-cache
# No public client key and no production fixture-mode variable.
